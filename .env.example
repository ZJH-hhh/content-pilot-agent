# No configuration is needed for the offline demo. All costs are simulated units.
PORT=3000
HOST=127.0.0.1
AGENT_MODEL_MODE=mock
# To enable real model decisions, set AGENT_MODEL_MODE=openai and these values.
# Credentials remain on the server. Never commit your .env file.
OPENAI_API_KEY=
# Base URL only; do not append /chat/completions here.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use the model identifier offered by your own provider.
OPENAI_MODEL=gpt-4.1-mini
# Bound each model request; default 90s, valid range 1000–180000 ms.
OPENAI_TIMEOUT_MS=90000
